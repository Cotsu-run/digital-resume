{
  "$schema": "hero-glass-shapes/v1",
  "description": "Two shapes (rectangle, ellipse) fused into ONE morphing form — a single iridescent-metal mesh whose surface shifts between the two silhouettes and back while it rotates. Consumed by the Three.js scene in index.html.",
  "scene": {
    "transition": "morph-combine",
    "morphDetail": 5,
    "holdMs": 700,
    "morphMs": 1200,
    "spinSpeed": 0.5,
    "spinAxis": [0.3, 1.0, 0.15],
    "cameraFov": 30,
    "cameraDistance": 7.5,
    "pixelRatioCap": 2,
    "background": "transparent"
  },
  "material": {
    "type": "iridescent-metal",
    "color": "#6c7789",
    "roughness": 0.34,
    "metalness": 0.82,
    "flatShading": false,
    "transmission": 0.0,
    "thickness": 1.6,
    "ior": 1.45,
    "reflectivity": 0.55,
    "iridescence": 1.0,
    "iridescenceIOR": 1.4,
    "iridescenceThicknessRange": [180, 620],
    "clearcoat": 0.0,
    "clearcoatRoughness": 0.12,
    "attenuationColor": "#eaf4ff",
    "attenuationDistance": 4.0,
    "envMapIntensity": 2.2
  },
  "shapes": [
    { "id": "rectangle", "geometry": "box",       "size": [2.1, 2.1, 2.1], "roundness": 10, "color": "#2b7cf0" },
    { "id": "ellipse",   "geometry": "ellipsoid", "radii": [1.26, 1.26, 1.26], "color": "#ffc53d" }
  ]
}
